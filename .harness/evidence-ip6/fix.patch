+/// The directory of the `cp.json` this process was started with, set once
+/// at boot by [`set_state_dir`]; the converged indexes live beside it.
+static STATE_DIR: std::sync::OnceLock<PathBuf> = std::sync::OnceLock::new();
+
+/// forge-git's `--cp-state-file` directory: the index root's default is
+/// `<dir>/references`. Production's `/var/lib/forge-control-plane/cp.json`
+/// keeps `/var/lib/forge-control-plane/references`; the dev stack's run
+/// directory gets an index root its unprivileged process can write.
+pub fn set_state_dir(dir: &Path) {
+    let _ = STATE_DIR.set(dir.to_path_buf());
+}
+
+/// `FORGE_REFERENCE_INDEX_DIR` when set, else `references` beside the
+/// state file's directory, else `/var/lib/forge-control-plane/references`.
+fn root_from(env: Option<String>, state_dir: Option<&Path>) -> PathBuf {
+    match env.filter(|v| !v.trim().is_empty()) {
+        Some(v) => PathBuf::from(v),
+        None => state_dir.map_or_else(
             || PathBuf::from("/var/lib/forge-control-plane/references"),
-            PathBuf::from,
-        )
+            |d| d.join("references"),
+        ),
+    }
+}
+
+/// Where the converged indexes live: see [`root_from`].
+fn index_root() -> PathBuf {
+    root_from(
+        std::env::var("FORGE_REFERENCE_INDEX_DIR").ok(),
+        STATE_DIR.get().map(PathBuf::as_path),
+    )
 }
 
