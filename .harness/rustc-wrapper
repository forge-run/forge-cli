#
# One hop in front of the declared RUSTC_WRAPPER (sccache today), for the one
# class of rustc invocation a compiler cache must never touch: cargo's PROBES.
#
# Before cargo compiles anything it asks rustc what the target looks like —
#
#   rustc -vV
#   rustc - --crate-name ___ --print=file-names --crate-type bin … --print=cfg
#
# — reading its "source" from stdin and printing an answer. That command line
# carries NO path from the lane it was asked in, so it is byte-identical in
# every checkout of every repo on the box. sccache keys on the command line, so
# concurrent lanes issue what looks to it like the same request; the answer one
# lane gets can be produced under another lane's working directory, and the
# caller sees `failed to run rustc to learn about target-specific information`
# naming a directory it never used. It reads exactly like a broken toolchain
# and cost four commit attempts to diagnose (translation-engine P2.4-prove).
#
# A probe is not compile work: it produces no artifact and there is nothing to
# cache, so running it bare loses no cache value at all. Everything else —
# every real compile — goes to the declared wrapper untouched, which is what
# keeps the cache doing its job.
#
# $FORGE_RUSTC_WRAPPER holds what the consumer declared. Empty means no cache
# was declared, so there is nothing to hop over.
# BE-89: every compile this hop sees is also a LEDGER line (below), so a
# compile it runs bare for want of a cache is "not reached", with the reason,
# rather than an absence nobody can count. A probe is not a compile and is
# never recorded.
_bare=""
if [ -z "${FORGE_RUSTC_WRAPPER:-}" ]; then
    _bare=no-cache-declared
# ...and never itself. Both seams that install this guard unwrap an already
# installed one first, so this cannot happen from the harness; a hand-set
# environment could, and a wrapper that execs itself does so forever.
elif [ "$FORGE_RUSTC_WRAPPER" = "$0" ]; then
    _bare=wrapper-is-this-hop
# An accelerator must never break a build (the same rule `.harness/cargo`
# applies to a missing wrapper): a declared wrapper that is not there makes
# this build slower, not wrong. `command` is a shell builtin, so this costs no
# process.
elif ! command -v "$FORGE_RUSTC_WRAPPER" >/dev/null 2>&1; then
    _bare=wrapper-not-on-path
fi
for a in "$@"; do
    case "$a" in
        # `--print=cfg` / `--print sysroot` — rustc is being asked a question.
        # `-` — the source is stdin, which no real compile ever uses.
        # `-vV` / `-V` / `--version` — the version probe cargo opens with.
        --print|--print=*|-|-vV|-V|--version)
            # Deliberately over-inclusive. A real compile that also asks for a
            # print (`--print=native-static-libs` alongside a staticlib build)
            # loses ONE crate's cache entry and compiles it for real; a probe
            # that slipped through would cost a wrong answer under a directory
            # the caller never used. Wrong in the direction that only costs
            # time, exactly as the lock's `*cargo*` test is.
            exec "$@"
            ;;
    esac
done

# A proc-macro's dylib names ITS OWN TARGET DIR, three ways (BE-89), and the
# same proc-macro built in two target dirs is two different files (82 bytes
# apart for zeroize_derive). On macOS ld64 sets LC_ID_DYLIB to the absolute
# output path unless told otherwise; with debuginfo on (forge-lang builds its
# build dependencies with it) the debug map's N_OSO stabs name every
# dependency rlib by its absolute path in the target dir; and a proc-macro
# that include!s a build script's output (rustversion) carries OUT_DIR, a
# path inside the target dir, into its crate hash. The LC_UUID and the code
# signature follow from all three. sccache hashes every --extern's CONTENTS,
# so every crate that uses a derive keyed differently in every verify tree,
# pool slot and lane: the before reading's misses on a second tree at the same
# sha (38 of forge-lang's, 129 of forge-runtime's, scripts/be89-results/) all
# had inputs identical to the first tree's. The install name by file name,
# `-S` (no stabs) and the target dir remapped make the dylib byte-identical
# wherever it is built. rustc loads a proc-macro by path and nothing links
# one, so the install name is read by nobody, the stabs serve only a debugger
# stepping into a derive, and the remap only renames paths in the macro's
# own panic messages. A proc-macro is never cacheable itself (a dylib), so
# these arguments cost no cache key.
_pm=""; _ef=""; _cn=""; _od=""; _prev=""
for a in "$@"; do
    case "$_prev:$a" in
        --crate-type:proc-macro) _pm=1 ;;
        -C:extra-filename=*) _ef="${a#extra-filename=}" ;;
        --crate-name:*) _cn="$a" ;;
        --out-dir:*) _od="$a" ;;
    esac
    _prev="$a"
done
if [ -n "$_pm" ]; then
    # <target>/<profile>/deps, or <target>/<triple>/<profile>/deps.
    case "$_od" in
        */deps) set -- "$@" "--remap-path-prefix=${_od%/*/deps}=/forge-target" ;;
    esac
    # GNU ld writes no install name and no stabs.
    if [ -d /System/Library/CoreServices ] && [ -n "$_cn" ]; then
        set -- "$@" -C "link-arg=-Wl,-install_name,@rpath/lib$_cn$_ef.dylib" -C link-arg=-Wl,-S
    fi
fi

# ── The rustc ledger (BE-89) ─────────────────────────────────────────────
#
# 40 of 50 verify rows in BE-1's ledger read hits 0 / misses 0, and nothing
# recorded could say why: sccache's counters are one total per server, shared
# by every lane on the box. So this hop, which every compile in every tree
# passes through (both `.harness/cargo` and the runner's gate env install it),
# writes ONE line per rustc call to <root>/.harness/log/rustc.jsonl: the
# crate, version and kind; each input sccache keys on, hashed separately
# (rustc, the arguments it hashes, RUSTFLAGS, incremental, every CARGO_* var
# it sees, the working dir, the paths, the dependencies); the tree, target
# dir and cwd; the wall; and the outcome. `dispatch.py builds cache-doctor`
# reads it back: a miss whose inputs differ from an earlier compile of the
# same crate and version is named by the input that differs.
#
# The outcome comes from sccache's own counters, read once after the call and
# diffed against the last reading any call on the box took: a window that
# moved by exactly one unit is that call's (`x` 1). Wider windows are a
# peer's compile in between, and the line says which way the window moved
# without claiming it. Not cacheable is decided from the arguments, by the
# rules sccache 0.17 applies, so it never needs the window at all.
#
# Fail-open on every path, and cheap: four processes (two `date`, one stats
# request to a server that is already up, one awk), measured under 20 ms a
# call (scripts/be89-results/). FORGE_RUSTC_LEDGER names the file, `off`
# turns it off; unset, an emitted hop uses the working root's — the nearest
# ancestor of its tree with a .harness/dispatch.py — and a tree with no such
# root keeps no ledger.
_led="${FORGE_RUSTC_LEDGER:-}"
_tree="${0%/.harness/rustc-wrapper}"
if [ -z "$_led" ]; then
    # Only an EMITTED hop, <tree>/.harness/rustc-wrapper, finds a root. The
    # source copy run by the harness's own tests sits inside a lane inside the
    # working root, and would write a test's builds into the fleet's ledger.
    case "$_tree" in
        "$0") ;;
        /*)
            _p="$_tree"; _n=0
            while [ "$_n" -lt 6 ] && [ -n "$_p" ]; do
                _p="${_p%/*}"
                if [ -f "$_p/.harness/dispatch.py" ]; then
                    _led="$_p/.harness/log/rustc.jsonl"; break
                fi
                _n=$(( _n + 1 ))
            done
            ;;
    esac
fi
case "$_led" in
    ""|off)
        [ -z "$_bare" ] || exec "$@"
        # The cache never sees the TARGET DIR, the lean settings (BE-52) or
        # the caller's TMPDIR (BE-121) — see below.
        unset CARGO_TARGET_DIR CARGO_INCREMENTAL CARGO_PROFILE_DEV_DEBUG TMPDIR
        exec "$FORGE_RUSTC_WRAPPER" "$@"
        ;;
esac
_target="${CARGO_TARGET_DIR:-}"
_t0="$(date +%s%N 2>/dev/null)"
if [ -n "$_bare" ]; then
    "$@"
else
    # The cache never sees the TARGET DIR either (BE-52). sccache hashes
    # CARGO_TARGET_DIR into every crate's key when it is in the environment,
    # and a verify tree, plan land's rung and any lane that sets it carry
    # their own path there: two byte-identical trees, one with it set, hit 1
    # and miss 1 on the same registry crate (scripts/be52-results/
    # key-probe.txt), and a fresh forge-runtime build with it set hit 0 of
    # 671 against a 27 GiB cache. rustc never reads it — cargo has already
    # put every path on the command line — and no crate the fleet compiles
    # reads it with env!(), so it is dropped here, on the hop to the cache,
    # and nowhere else. The lean settings cargo.sh exports are dropped for
    # the same reason: sccache hashes every CARGO_* variable, so a tree with
    # CARGO_INCREMENTAL=0 missed on a registry crate a tree without it had
    # just cached, and hit once the hop unset it (key-probe.txt). Cargo has
    # already turned both into -C incremental / -C debuginfo on the command
    # line, which the cache keys on, and rustc reads neither.
    #
    # Nor the caller's TMPDIR (BE-121). A client that finds no server starts
    # one, and the server keeps the client's environment for as long as it
    # lives, serving every lane on the box. forge-runtime's gates point
    # TMPDIR at a per-run scratch subdirectory release() reaps, so a server
    # spawned from a compile in one gate failed every later compile on the
    # box ("No such file or directory" under the reaped .../forge-storage-
    # tests/sccacheXXXX) while still answering --show-stats: 24 fixture-
    # building tests red on BE-120's land, 2026-10-31. cargo.sh's
    # _sccache_start already strips it (BE-52); this is the other way a
    # server is born. rustc keeps no state in TMPDIR, and the server, not
    # this client, runs the compile.
    unset CARGO_TARGET_DIR CARGO_INCREMENTAL CARGO_PROFILE_DEV_DEBUG TMPDIR
    "$FORGE_RUSTC_WRAPPER" "$@"
fi
_rc=$?
_t1="$(date +%s%N 2>/dev/null)"
_dir="${_led%/*}"
[ -d "$_dir/rustc-sc" ] || mkdir -p "$_dir/rustc-sc" 2>/dev/null
_snap=""
case "$_bare:${FORGE_RUSTC_WRAPPER##*/}" in
    :sccache)
        # To a file, never through $(...): a server the client spawns holds
        # the client's stdout, and a substitution waits for every holder.
        # One of 64 slots, so the files are bounded; two calls colliding in
        # the same slot inside the same few ms read as unattributed.
        _snap="$_dir/rustc-sc/$(( $$ % 64 ))"
        "$FORGE_RUSTC_WRAPPER" --show-stats --stats-format=json >"$_snap" 2>/dev/null </dev/null || _snap=""
        ;;
esac
LC_ALL=C awk -v t0="$_t0" -v t1="$_t1" -v rc="$_rc" -v bare="$_bare" \
    -v tree="$_tree" -v target="$_target" -v cwd="$PWD" -v snap="$_snap" \
    -v last="$_dir/rustc-sc/last" -v pid="$$" '
function h(s,   i, n, a, b, c) {
    a = 5381; b = 0; n = length(s)
    for (i = 1; i <= n; i++) {
        c = ORD[substr(s, i, 1)]
        a = (a * 33 + c) % 4294967291
        b = (b * 31 + c + 7) % 4294967279
    }
    return sprintf("%08x%08x", a, b)
}
function q(s) {
    gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/[\001-\037]/, " ", s)
    return "\"" s "\""
}
function base(s) { sub(/.*\//, "", s); return s }
# One counter out of `--show-stats --stats-format=json`: an int, or the sum of
# a {"counts":{...}} map. -1 when absent.
function cnt(js, key,   p, s, e, t) {
    p = index(js, "\"" key "\":"); if (!p) return -1
    s = substr(js, p + length(key) + 3)
    if (substr(s, 1, 1) == "{") {
        p = index(s, "\"counts\":{"); if (!p) return 0
        s = substr(s, p + 10); e = index(s, "}"); s = substr(s, 1, e - 1)
        t = 0
        while (match(s, /:[0-9]+/)) { t += substr(s, RSTART + 1, RLENGTH - 1); s = substr(s, RSTART + RLENGTH) }
        return t
    }
    if (match(s, /^[0-9]+/)) return substr(s, 1, RLENGTH) + 0
    return -1
}
function ncmap(js,   p, s, e) {
    p = index(js, "\"not_cached\":{"); if (!p) return ""
    s = substr(js, p + 14); e = index(s, "}"); s = substr(s, 1, e - 1)
    gsub(/"/, "", s); return s
}
BEGIN {
    for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i
    rustc = ARGV[1]; crate = ""; ctypes = ""; test = 0; inc = 0; src = ""; outdir = 0
    args = ""; deps = ""
    for (i = 2; i < ARGC; i++) {
        a = ARGV[i]
        if (a == "--extern" || a == "-L" || a == "--out-dir") {
            v = ARGV[++i]
            if (a == "--extern") {
                e = index(v, "="); deps = deps (e ? substr(v, 1, e) base(substr(v, e + 1)) : v) "\001"
                # A dylib dependency (a proc-macro): its contents are in the
                # key and its name hash is not, so the doctor counts them.
                if (v ~ /\.(dylib|so|dll)$/) dy++
            }
            if (a == "--out-dir") outdir = 1
            continue
        }
        if (a == "--crate-name") { crate = ARGV[i + 1] }
        if (a == "--crate-type") { ctypes = ctypes "," ARGV[i + 1] }
        if (a == "--test") test = 1
        if (a == "-C" && ARGV[i + 1] ~ /^incremental=/) { inc = 1; i++; args = args "-C incremental\001"; continue }
        if (a ~ /^-Cincremental=/) { inc = 1; args = args "-C incremental\001"; continue }
        if (a !~ /^-/ && a ~ /\.rs$/) src = a
        args = args a "\001"
    }
    if (crate ~ /^build_script_/) kind = "build-script"
    else if (test) kind = "test"
    else if (ctypes ~ /proc-macro/) kind = "proc-macro"
    else if (ctypes ~ /bin/) kind = "bin"
    else if (ctypes ~ /(^|,)(r?lib|staticlib)/) kind = "lib"
    else kind = "other"
    # What sccache 0.17 declines, in the order its argument parser declines
    # it: incremental first (it is read inside the argument loop), then any
    # crate type that is not rlib/staticlib (rustc links those itself, so the
    # linker inputs are unknown to the cache), then a call with no --out-dir.
    why = ""
    if (inc) why = "incremental"
    else if (ctypes == "" || ctypes ~ /(bin|proc-macro|dylib|cdylib)/) why = "crate-type"
    else if (!outdir) why = "missing-out-dir"
    # Every CARGO_* var sccache hashes (all but CARGO_MAKEFLAGS), sorted, one
    # hash each so the doctor can name WHICH one moved; CARGO_PKG_* are a
    # function of the crate and version and share one.
    n = 0
    for (k in ENVIRON) if (k ~ /^CARGO_/ && k != "CARGO_MAKEFLAGS") K[++n] = k
    for (i = 2; i <= n; i++) { v = K[i]; for (j = i - 1; j > 0 && K[j] > v; j--) K[j + 1] = K[j]; K[j + 1] = v }
    cenv = ""; pkg = ""; envs = ""
    for (i = 1; i <= n; i++) {
        k = K[i]; cenv = cenv k "=" ENVIRON[k] "\001"
        if (k ~ /^CARGO_PKG_/) { pkg = pkg k "=" ENVIRON[k] "\001"; continue }
        envs = envs (envs == "" ? "" : ",") q(substr(k, 7)) ":" q(substr(h(ENVIRON[k]), 1, 8))
    }
    if (pkg != "") envs = envs (envs == "" ? "" : ",") "\"PKG_*\":" q(substr(h(pkg), 1, 8))
    rf = ENVIRON["RUSTFLAGS"] "\001" ENVIRON["CARGO_ENCODED_RUSTFLAGS"] "\001" ENVIRON["CARGO_BUILD_RUSTFLAGS"]
    md = ENVIRON["CARGO_MANIFEST_DIR"]
    hs = "\"rustc\":" q(h(rustc)) ",\"args\":" q(h(args)) ",\"src\":" q(h(src)) \
         ",\"rustflags\":" q(h(rf)) ",\"incremental\":" q(h(inc "|" ENVIRON["CARGO_INCREMENTAL"])) \
         ",\"cargo_env\":" q(h(cenv)) ",\"cwd\":" q(h(cwd)) ",\"path\":" q(h(cwd "\001" md "\001" src)) \
         ",\"deps\":" q(h(deps))
    out = ""; x = 0; sc = "null"; d = "null"
    if (bare != "") { out = "not-reached"; why = bare }
    else if (snap != "") {
        js = ""; while ((getline line < snap) > 0) js = js line; close(snap)
        ch = cnt(js, "cache_hits"); cm = cnt(js, "cache_misses")
        cn = cnt(js, "requests_not_cacheable"); ce = cnt(js, "cache_errors")
        if (ch >= 0 && cm >= 0 && cn >= 0) {
            sc = "[" ch "," cm "," cn "," (ce < 0 ? 0 : ce) "]"
            pl = ""; if ((getline pl < last) > 0) {} ; close(last)
            split(pl, P, " ")
            print ch " " cm " " cn " " (ce < 0 ? 0 : ce) > last; close(last)
            if (pl != "" && P[1] <= ch && P[2] <= cm && P[3] <= cn) {
                dh = ch - P[1]; dm = cm - P[2]; dn = cn - P[3]; de = (ce < 0 ? 0 : ce) - P[4]
                d = "[" dh "," dm "," dn "," de "]"
                tot = dh + dm + dn + de
                if (why != "") { out = "not-cacheable"; x = (tot == 1 && dn == 1) }
                else if (tot == 1 && dh == 1) { out = "hit"; x = 1 }
                else if (tot == 1 && dm == 1) { out = "miss"; x = 1 }
                else if (dh > 0 && dm == 0) out = "hit"
                else if (dm > 0 && dh == 0) out = "miss"
                else out = "unattributed"
            }
        }
    }
    if (out == "") out = (why != "" ? "not-cacheable" : "unattributed")
    ms = (t0 ~ /^[0-9]+$/ && t1 ~ /^[0-9]+$/) ? int((t1 - t0) / 1000000) : -1
    tms = (t1 ~ /^[0-9]+$/) ? int(t1 / 1000000) : -1
    printf "{\"t\":%d,\"ms\":%d,\"rc\":%d,\"tree\":%s,\"target\":%s,\"cwd\":%s,\"crate\":%s,\"ver\":%s,\"kind\":%s,\"out\":%s,\"why\":%s,\"x\":%d,\"sc\":%s,\"d\":%s,\"pid\":%d,\"dy\":%d,\"run\":%s,\"h\":{%s},\"env\":{%s}}\n", \
        tms, ms, rc, q(base(tree)), q(target), q(cwd), q(crate), q(ENVIRON["CARGO_PKG_VERSION"]), q(kind), \
        q(out), (why == "" ? "null" : q(why)), x, sc, d, pid, dy + 0, \
        (ENVIRON["HARNESS_RUN_ID"] == "" ? "null" : q(ENVIRON["HARNESS_RUN_ID"])), hs, envs
    exit
}' "$@" >>"$_led" 2>/dev/null
exit "$_rc"
