#!/bin/sh
# Generated by forge-sdlc-harness (harness build) — do not edit; edits are drift.
#
# One hop in front of the declared RUSTC_WRAPPER (sccache today), for the one
# class of rustc invocation a compiler cache must never touch: cargo's PROBES.
#
# Before cargo compiles anything it asks rustc what the target looks like —
#
#   rustc -vV
#   rustc - --crate-name ___ --print=file-names --crate-type bin … --print=cfg
#
# — reading its "source" from stdin and printing an answer. That command line
# carries NO path from the lane it was asked in, so it is byte-identical in
# every checkout of every repo on the box. sccache keys on the command line, so
# concurrent lanes issue what looks to it like the same request; the answer one
# lane gets can be produced under another lane's working directory, and the
# caller sees `failed to run rustc to learn about target-specific information`
# naming a directory it never used. It reads exactly like a broken toolchain
# and cost four commit attempts to diagnose (translation-engine P2.4-prove).
#
# A probe is not compile work: it produces no artifact and there is nothing to
# cache, so running it bare loses no cache value at all. Everything else —
# every real compile — goes to the declared wrapper untouched, which is what
# keeps the cache doing its job.
#
# $FORGE_RUSTC_WRAPPER holds what the consumer declared. Empty means no cache
# was declared, so there is nothing to hop over.
[ -n "${FORGE_RUSTC_WRAPPER:-}" ] || exec "$@"
# ...and never itself. Both seams that install this guard unwrap an already
# installed one first, so this cannot happen from the harness; a hand-set
# environment could, and a wrapper that execs itself does so forever.
[ "$FORGE_RUSTC_WRAPPER" != "$0" ] || exec "$@"
# An accelerator must never break a build (the same rule `.harness/cargo`
# applies to a missing wrapper): a declared wrapper that is not there makes
# this build slower, not wrong. `command` is a shell builtin, so this costs no
# process.
command -v "$FORGE_RUSTC_WRAPPER" >/dev/null 2>&1 || exec "$@"
for a in "$@"; do
    case "$a" in
        # `--print=cfg` / `--print sysroot` — rustc is being asked a question.
        # `-` — the source is stdin, which no real compile ever uses.
        # `-vV` / `-V` / `--version` — the version probe cargo opens with.
        --print|--print=*|-|-vV|-V|--version)
            # Deliberately over-inclusive. A real compile that also asks for a
            # print (`--print=native-static-libs` alongside a staticlib build)
            # loses ONE crate's cache entry and compiles it for real; a probe
            # that slipped through would cost a wrong answer under a directory
            # the caller never used. Wrong in the direction that only costs
            # time, exactly as the lock's `*cargo*` test is.
            exec "$@"
            ;;
    esac
done
exec "$FORGE_RUSTC_WRAPPER" "$@"
